+            if (remainingItemCount != itemCountToMove) {
+                origItemStack.setCount(removeOriginalItem ? originalItemCount - movedItemCount + remainingItemCount : originalItemCount);
+                container.setItem(i, origItemStack);
+                container.setChanged();
                 return true;
             }
-        }
-
